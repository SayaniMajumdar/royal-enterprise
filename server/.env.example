# ==============================================================================
# ROYAL ENTERPRISE - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Rate Limiting Configuration (Defaults: 15 minutes window, 40 requests max)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=40

# ------------------------------------------------------------------------------
# GOOGLE SHEETS INTEGRATION (Choose Option A or Option B)
# ------------------------------------------------------------------------------

# OPTION A: Google Apps Script Web App (RECOMMENDED - Quick 2-Minute Setup)
# Deploy google-apps-script.js inside your Google Spreadsheet and paste the Web App URL here:
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx.../exec

# OPTION B: Google Sheets API v4 via Google Cloud Service Account
# 1. The ID of the spreadsheet found in the URL:
#    https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# 2. The client email generated from your Google Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=royal-enterprise-sa@your-project-id.iam.gserviceaccount.com

# 3. The private key from your downloaded service account JSON key file.
# Note: Keep the quotes and preserve the \n newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"
